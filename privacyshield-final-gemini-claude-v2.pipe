      "id": "prompt_1",
      "provider": "prompt",
      "name": "PII Redaction Prompt",
      "description": "Instructs Claude to return only sanitized text.",
      "config": {
        "instructions": [
          "Redact personally identifiable information from the supplied text.",
          "Mask names, email addresses, phone numbers, street addresses, Social Security numbers, dates of birth, credit-card numbers, bank-account numbers, passport numbers, driver-license numbers, IP addresses, and other clearly sensitive identifiers.",
          "Replace each sensitive value with [REDACTED]. Preserve all non-sensitive wording, punctuation, and line breaks as closely as possible.",
          "Return only the redacted text. Do not explain the changes, add headings, warnings, or commentary."
        ],
        "name": "PII Redaction Prompt"
