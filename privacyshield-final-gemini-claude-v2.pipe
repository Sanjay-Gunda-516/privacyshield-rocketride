      "id": "vision_1",
      "provider": "image_vision_gemini",
      "name": "Gemini Vision OCR",
      "description": "Uses Gemini Vision to extract readable text from images.",
      "config": {
        "profile": "gemini-3_1-pro-preview",
        "gemini-2_5-flash": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}",
          "systemPrompt": "You are an OCR extraction component. Accurately transcribe all readable text from the supplied image. Preserve the original wording and useful line breaks. Return only the extracted text with no explanation or commentary.",
          "prompt": "Extract all readable text from the supplied image.\nPreserve names, addresses, email addresses, phone numbers, dates, IDs, and other visible text exactly as written.\nPreserve useful line breaks.\nReturn only the extracted text. Do not summarize, interpret, redact, or add commentary."
        },
        "apikey": "${ROCKETRIDE_GEMINI_KEY}",
        "vision": {
          "systemPrompt": "You are an OCR extraction component. Accurately transcribe readable text from the supplied image.",
          "prompt": "Extract all readable text from this image. Preserve line breaks where useful. Return only the extracted text with no explanation or commentary."
        },
        "name": "Gemini Vision OCR",
        "parameters": {
          "google": {}
        },
        "gemini-3_1-pro-preview": {
          "apikey": "${ROCKETRIDE_GEMINI_KEY}",
          "systemPrompt": "You are an OCR extraction component. Accurately transcribe all readable text from the supplied image. Preserve the original wording and useful line breaks. Return only the extracted text with no explanation or commentary.",
          "prompt": "Extract all readable text from the supplied image.\nPreserve names, addresses, email addresses, phone numbers, dates, IDs, and other visible text exactly as written.\nPreserve useful line breaks.\nReturn only the extracted text. Do not summarize, interpret, redact, or add commentary.\n"
        }
