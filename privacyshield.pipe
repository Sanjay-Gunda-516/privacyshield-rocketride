      }
    },
    {
      "id": "parse_1",
      "provider": "parse",
      "name": "Parser",
      "description": "Parses uploaded content and extracts text and embedded media.",
      "config": {
        "name": "Parser"
      },
      "ui": {
        "position": {
          "x": 430,
          "y": 320
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "tags",
          "from": "webhook_1"
        }
      ]
    },
    {
      "id": "ocr_1",
      "provider": "ocr",
      "name": "OCR",
      "description": "Extracts machine-readable text from images and scanned pages.",
      "config": {
        "engine": "easyocr",
        "profile": "latin",
        "script_family": "latin",
        "table_engine": "doctr",
        "latin": {
          "engine": "easyocr",
          "script_family": "latin",
          "table_engine": "doctr"
        },
        "name": "OCR",
        "parameters": {
          "google": {}
        }
      },
      "ui": {
        "position": {
          "x": 730,
          "y": 500
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "image",
          "from": "parse_1"
        },
        {
          "lane": "image",
          "from": "webhook_1"
        }
      ]
    },
    {
      "id": "ner_1",
      "provider": "ner",
      "name": "Named Entity Recognition",
      "description": "Runs BERT-based named-entity recognition as an analysis branch.",
      "config": {
        "profile": "bertBase",
        "name": "Named Entity Recognition",
        "bertBase": {
          "aggregation_strategy": "simple",
          "min_confidence": 0.85,
          "store_in_metadata": true
        }
      },
      "ui": {
        "position": {
          "x": 1030,
          "y": 320
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "parse_1"
        },
        {
          "lane": "text",
          "from": "ocr_1"
        }
      ]
    },
    {
      "id": "anonymize_text_1",
      "provider": "anonymize_text",
      "name": "PII Anonymizer",
      "description": "Detects PII with GLiNER Multi PII and masks matched spans.",
      "config": {
        "profile": "glinerMultiPII",
        "glinerMultiPII": {
          "anonymizeChar": "█",
          "entityTypes": [
            "person",
            "name",
            "email",
            "phone number",
            "address",
            "social security number",
            "credit card number",
            "date of birth",
            "organization",
            "company",
            "location",
            "ip address",
            "bank account",
            "passport number",
            "driver license"
          ],
          "redactionStyle": "mask"
        },
        "name": "PII Anonymizer"
      },
      "ui": {
        "position": {
          "x": 1330,
          "y": 320
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "parse_1"
        },
        {
          "lane": "text",
          "from": "ocr_1"
        }
      ]
    },
    {
      "id": "response_1",
      "provider": "response",
      "name": "Redacted Response",
      "description": "Returns sanitized text to the HTTP caller under redacted_text.",
      "config": {
        "profile": "default",
        "lanes": [
          {
            "laneId": "text",
            "laneName": "redacted_text"
          }
        ],
        "name": "Redacted Response"
      },
      "ui": {
        "position": {
          "x": 1520,
          "y": 330
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "text",
          "from": "anonymize_text_1"
        }
      ]
    }
  ],
