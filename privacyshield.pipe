{
  "components": [
    {
      "id": "webhook_1",
      "provider": "webhook",
      "name": "Webhook",
      "description": "HTTP entry point for text, documents, and images.",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook",
        "name": "Webhook"
      },
      "ui": {
        "position": {
